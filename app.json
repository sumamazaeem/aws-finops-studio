{
  "name": "aws-finops-studio",
  "version": "0.1.0",
  "displayName": "AWS FinOps Studio",
  "description": "Read-only AWS cost intelligence, optimization tracking, and evidence-backed FinOps reporting.",
  "author": "AWS FinOps Studio",
  "iconPath": "assets/icon.png",
  "tags": ["aws", "finops", "cost-optimization", "read-only"],
  "useCases": ["Understand AWS spend and cost drivers", "Prioritize and track optimization recommendations", "Generate evidence-backed FinOps reports"],
  "configuration": ["Demo mode works without AWS credentials", "For live analysis, configure an AWS profile and least-privilege read-only access"],
  "minKiroCrewVersion": "0.6.0",
  "agents": ["agents/finops-agent.json"],
  "skills": [
    "skills/finops-studio",
    "skills/aws-billing-and-cost-management",
    "skills/aws-storage",
    "skills/aws-observability",
    "skills/aws-iam",
    "skills/aws-well-architected-review"
  ],
  "mcpServers": {
    "aws-finops-readonly": {
      "command": "python3",
      "args": ["backend/mcp_proxy.py"],
      "env": {}
    }
  },
  "backend": {"entryPoint": "backend/server.py", "type": "python", "port": "auto", "healthCheck": "/health", "routes": "/api/apps/aws-finops-studio"},
  "ui": {"entry": "dist/index.mjs", "pages": [{"route": "/apps/aws-finops-studio", "label": "FinOps Studio", "icon": "Package"}]},
  "permissions": {
    "api": [
      "/apps/aws-finops-studio/api/status",
      "/apps/aws-finops-studio/api/overview",
      "/apps/aws-finops-studio/api/recommendations",
      "/apps/aws-finops-studio/api/reports",
      "/apps/aws-finops-studio/api/diagnostics",
      "/apps/aws-finops-studio/api/refresh-live",
      "/apps/aws-finops-studio/api/evidence",
      "/apps/aws-finops-studio/api/calculate",
      "/apps/aws-finops-studio/api/profiles",
      "/apps/aws-finops-studio/api/policies",
      "/apps/aws-finops-studio/api/schedules",
      "/api/crons"
    ],
    "events": [], "storage": true, "cron": true, "memory": "app-scoped", "network": false,
    "sessionApproval": false, "spawn": false, "jobs": false
  }
}
